# Luviio frontend — environment example
# Copy to `.env` and fill in values. NEVER commit the real `.env` file.
#
# Only public / non-secret values belong in the browser bundle:
#  - API base URL (may be a public deploy or relative /api/v1)
#  - Stripe PUBLISHABLE key (pk_...) — this is safe for clients.
# Server-only secrets (Stripe secret key, Supabase service role, etc.)
# must NEVER be placed in this file or in any client-side code.

# Backend base URL (include trailing /api/v1). Defaults in code to the
# dev koyeb backend, or /api/v1 in production.
VITE_API_BASE=https://apparent-jordanna-pixelart002-42e39ac6.koyeb.app/api/v1

# Stripe publishable key (pk_live_... / pk_test_...)
VITE_STRIPE_PK=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
