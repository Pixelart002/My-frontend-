{
  "name": "luviio-frontend",
  "private": true,
  "config": {
    "fund": false
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:css && node scripts/generate-sitemap.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "format:check": "prettier --check .",
    "build:css": "tailwindcss -c ./tailwind.config.cjs -i ./src/styles/tailwind-input.css -o ./public/tailwind.css --minify"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.13",
    "vitest": "^5.0.0",
    "@eslint/js": "^9.39.5"
  },
  "dependencies": {
    "@remixicon/react": "^4.2.0",
    "@stripe/react-stripe-js": "^3.1.4",
    "@stripe/stripe-js": "^6.1.0",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.9.4",
    "vite": "^8.2.2",
    "@vercel/functions": "3.9.9"
  },
  "type": "module"
}
