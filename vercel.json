{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/admin.html", "destination": "/admin", "permanent": true },
    { "source": "/shop.html", "destination": "/shop", "permanent": true },
    { "source": "/cart.html", "destination": "/cart", "permanent": true },
    { "source": "/checkout.html", "destination": "/checkout", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/register.html", "destination": "/register", "permanent": true },
    { "source": "/forgot-password.html", "destination": "/forgot-password", "permanent": true },
    { "source": "/orders.html", "destination": "/orders", "permanent": true },
    { "source": "/profile.html", "destination": "/account", "permanent": true },
    { "source": "/addresses.html", "destination": "/account/addresses", "permanent": true },
    { "source": "/about.html", "destination": "/about", "permanent": true },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/terms.html", "destination": "/terms", "permanent": true },
    { "source": "/shipping-policy.html", "destination": "/shipping", "permanent": true },
    { "source": "/refund-policy.html", "destination": "/refund", "permanent": true },
    { "source": "/return-cancellation.html", "destination": "/returns", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://apparent-jordanna-pixelart002-42e39ac6.koyeb.app/api/$1" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/order/success", "destination": "/index.html" },
    { "source": "/order/failed", "destination": "/index.html" },
    { "source": "/orders", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/account/addresses", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/shipping", "destination": "/index.html" },
    { "source": "/refund", "destination": "/index.html" },
    { "source": "/returns", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/product/(.*)", "destination": "/index.html" },
    { "source": "/ads.txt", "destination": "/ads.txt" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\" \"https://hooks.stripe.com\"), publickey-credentials-get=(self \"https://js.stripe.com\" \"https://hooks.stripe.com\")" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://js.stripe.com https://pagead2.googlesyndication.com https://fundingchoicesmessages.google.com https://ep2.adtrafficquality.google; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; connect-src 'self' https://apparent-jordanna-pixelart002-42e39ac6.koyeb.app https://api.stripe.com https://fundingchoicesmessages.google.com https://ep1.adtrafficquality.google https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net; frame-src https://js.stripe.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://ep2.adtrafficquality.google https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/(.*)\\.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
  ]
}
